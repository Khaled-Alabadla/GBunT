{
  "version": 2,
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend"
    },
    "backend": {
      "entrypoint": "backend/src/server.js"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "backend/src/server.js" },
    { "source": "/(.*)", "destination": "frontend/$1" }
  ]
}
